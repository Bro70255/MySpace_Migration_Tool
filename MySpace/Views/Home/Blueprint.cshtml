@{
    ViewData["Title"] = "Blueprint";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Blueprint</title>
</head>

<body>

    <div class="bp-wrap">
        <div class="bp-canvas">

            <div class="bp-project" id="projectTitle">
                PROJECT BLUEPRINT
            </div>

            <!-- Expand / Collapse All -->
            <div class="tree-controls">
                <label class="tree-toggle">
                    <input type="checkbox" id="toggleBlueprintAll" />
                    <span>Expand all</span>
                </label>
            </div>

            <div class="blueprint">
                <div id="blueprintTree" class="tree-root"></div>
            </div>

        </div>
    </div>
    <div class="bp-wrap">
        <div class="bp-canvas">
            <div class="bp-project">PROJECT BLUEPRINT</div>

            <div class="blueprint">
                <div id="blueprintTree" class="tree-root"></div>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE CODE VIEWER -->
    <div id="codeViewer" class="code-viewer">

        <!-- Header -->
        <div class="code-header">
            <span id="codeTitle">Code Viewer</span>
            <button onclick="closeCodeViewer()">✕</button>
        </div>

        <!-- Code Content -->
        <div id="codeContent"></div>

    </div>



    <!-- Scripts -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            loadBlueprint();

            function applyExpandAll(expand) {
                document.querySelectorAll("#blueprintTree .tree-item").forEach(node => {
                    const children = node.querySelector(".tree-children");
                    if (children && children.children.length > 0) {
                        node.classList.toggle("open", expand);
                    }
                });
            }

            document.addEventListener("change", function (e) {
                if (e.target.id === "toggleBlueprintAll") {
                    applyExpandAll(e.target.checked);
                }
            });

            window.__applyBlueprintExpandAll = function () {
                const cb = document.getElementById("toggleBlueprintAll");
                if (cb && cb.checked) applyExpandAll(true);
            };
        });
    </script>



</body>
</html>
