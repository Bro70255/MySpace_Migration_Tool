@{
    ViewData["Title"] = "Dashboard";

    // These are READ by _Layout.cshtml
    ViewData["PageTitle"] = "MySpace Workspace";
    ViewData["PageSubtitle"] = "Centralized management of projects, infrastructure, and services";
    ViewData["ShowZooZoo"] = true;
}

<div class="dashboard-container">

    <!-- DASHBOARD CARDS -->
    <div class="row g-4">

        <!-- 1 : Projects & Backups -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card"
                 onclick="location.href='/Home/Projects'"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-primary-soft">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <h5>Projects & Backups</h5>
                <p>Manage projects, branches, and backups</p>
            </div>
        </div>

        <!-- 2 : Database & Backups -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card"
                 onclick="location.href='/Home/Database'"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-success-soft">
                    <i class="bi bi-database"></i>
                </div>
                <h5>Database & Backups</h5>
                <p>Monitor database status, manage backups, and perform recovery</p>
            </div>
        </div>


        <!-- 3 : Blueprint -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-info-soft">
                    <i class="bi bi-diagram-2"></i>
                </div>
                <h5>Project Blueprint</h5>
                <p>Visualize and manage project architecture</p>
            </div>
        </div>

        <!-- 4 : Migration -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-warning-soft">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <h5>Project Migration</h5>
                <p>Migrate projects between platforms</p>
            </div>
        </div>

        <!-- 5 : Domains -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-info-soft">
                    <i class="bi bi-globe"></i>
                </div>
                <h5>Project Domains</h5>
                <p>Manage domain mappings and routing</p>
            </div>
        </div>

        <!-- 6 : Server -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-warning-soft">
                    <i class="bi bi-hdd-network"></i>
                </div>
                <h5>Server Management</h5>
                <p>Monitor servers and system health</p>
            </div>
        </div>

        <!-- 7 : Helpdesk -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card"
                 onclick="toggleZooZooChat()"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-danger-soft">
                    <i class="bi bi-headset"></i>
                </div>
                <h5>Helpdesk</h5>
                <p>Ask questions or contact support</p>
            </div>
        </div>

        <!-- 8 : Billing -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-secondary-soft">
                    <i class="bi bi-credit-card"></i>
                </div>
                <h5>Billing & Account</h5>
                <p>Subscriptions, invoices, and usage</p>
            </div>
        </div>

        <!-- 9 : AI Settings -->
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-primary-soft">
                    <i class="bi bi-robot"></i>
                </div>
                <h5>AI Settings</h5>
                <p>Configure AI behavior, alerts, and automation</p>
            </div>
        </div>

    </div>

</div>
