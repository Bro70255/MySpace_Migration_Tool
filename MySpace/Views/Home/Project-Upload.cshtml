@{
    ViewData["Title"] = "Project-Upload";
}

<div class="content-wrapper">

    <div class="glass-body module-wrapper">

        <!-- ================= HEADER ================= -->
        <div class="module-header">
            <span class="module-icon">📁</span>
            <span class="module-title">Upload Entire Project</span>
        </div>

        <div class="module-body">

            <!-- ================= MESSAGE ================= -->
            <div id="uploadMessage" class="upload-message" style="display:none;"></div>

            <!-- ================= UPLOAD ZONE ================= -->
            <div id="dropZone" class="upload-zone single-action">

                <p class="upload-title">Upload Project Folder</p>
                <p class="upload-subtitle">
                    Select the root folder of your project.<br />
                    All files & subfolders will be uploaded.
                </p>

                <!-- Hidden Folder Input -->
                <input type="file" id="folderInput" multiple webkitdirectory hidden />

                <div class="upload-actions">
                    <button type="button" class="modern-btn primary" id="btnFolder">
                        Select Project Folder
                    </button>
                </div>

                <div class="upload-info" id="uploadInfo"></div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        function showMessage(message, type) {
            const msg = document.getElementById("uploadMessage");
            msg.className = `upload-message ${type}`;
            msg.innerText = message;
            msg.style.display = "block";
            setTimeout(() => msg.style.display = "none", 4000);
        }

        function buildFormData(files) {
            const formData = new FormData();

            // IMPORTANT: keep folder structure
            Array.from(files).forEach(f => {
                formData.append("files", f, f.webkitRelativePath || f.name);
            });

            return formData;
        }

        function uploadNow(files) {
            const formData = buildFormData(files);

            $.ajax({
                url: "/Home/UploadScreenFolder",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res && res.success)
                        showMessage(res.message || "Project uploaded successfully", "success");
                    else
                        showMessage(res.message || "Upload failed", "error");
                },
                error: function (xhr) {
                    showMessage("Upload error: " + (xhr.responseText || xhr.statusText), "error");
                }
            });
        }

        document.addEventListener("DOMContentLoaded", () => {

            const folderInput = document.getElementById("folderInput");
            const btnFolder = document.getElementById("btnFolder");
            const uploadInfo = document.getElementById("uploadInfo");

            btnFolder.addEventListener("click", () => folderInput.click());

            folderInput.addEventListener("change", e => {
                const files = e.target.files;
                if (!files || files.length === 0) return;

                uploadInfo.innerHTML = `
                    <div class="upload-count">${files.length} files detected</div>
                    <ul></ul>
                `;

                const ul = uploadInfo.querySelector("ul");
                Array.from(files).slice(0, 8).forEach(f => {
                    const li = document.createElement("li");
                    li.textContent = f.webkitRelativePath;
                    ul.appendChild(li);
                });

                if (files.length > 8) {
                    const li = document.createElement("li");
                    li.textContent = `... and ${files.length - 8} more files`;
                    ul.appendChild(li);
                }

                uploadNow(files);
            });
        });
    </script>
}
