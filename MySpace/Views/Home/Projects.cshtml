@{
    ViewData["Title"] = "Projects & Backups";

    // Read by _Layout.cshtml
    ViewData["PageTitle"] = "Projects & Backups";
    ViewData["PageSubtitle"] = "Upload projects, manage existing ones, and access backups";
    ViewData["ShowZooZoo"] = true;
}

<div class="dashboard-container">

    <div class="row g-4 justify-content-start">

        <!-- Upload Projects -->
        <div class="col-md-6 col-lg-4">
            <div class="dashboard-card"
                 onclick="location.href='/Home/Projects-Upload'"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-primary-soft">
                    <i class="bi bi-cloud-upload"></i>
                </div>
                <h5>Upload Projects</h5>
                <p>Upload new project files and details</p>
            </div>
        </div>

        <!-- Existing Projects -->
        <div class="col-md-6 col-lg-4">
            <div class="dashboard-card"
                 onclick="location.href='/Home/Projects-Existing'"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-success-soft">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <h5>Existing Projects</h5>
                <p>View and manage existing projects</p>
            </div>
        </div>

        <!-- Project Backups -->
        <div class="col-md-6 col-lg-4">
            <div class="dashboard-card"
                 onclick="location.href='/Home/Projects-Backups'"
                 style="cursor:pointer;">
                <div class="dashboard-icon bg-warning-soft">
                    <i class="bi bi-hdd-stack"></i>
                </div>
                <h5>Project Backups</h5>
                <p>Access and manage third-party stored project backups</p>
            </div>
        </div>

    </div>

</div>
