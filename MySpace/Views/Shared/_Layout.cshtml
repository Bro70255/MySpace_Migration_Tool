<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MySpace</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link href="~/css/site.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js?v=@DateTime.Now.Ticks"></script>
</head>

<body>

    <!-- NAVIGATION -->
    <header>
        <nav class="navbar navbar-expand-sm nav-modern">
            <div class="container-fluid">

                <!-- BRAND -->
                <a class="navbar-brand nav-brand-modern"
                   asp-controller="Home"
                   asp-action="Dashboard">
                    MySpace
                </a>

                <!-- RIGHT SIDE SINGLE DROPDOWN -->
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center"
                           href="#"
                           id="accountDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i>
                            User Menu

                        </a>

                        <ul class="dropdown-menu dropdown-menu-end glass-dropdown"
                            aria-labelledby="accountDropdown">

                            <!-- ACCOUNT -->
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Home"
                                   asp-action="MyAccount">
                                    <i class="bi bi-person me-2"></i> My Account
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Home"
                                   asp-action="MySpace_Dashboard">
                                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                                </a>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <!-- BLUEPRINT PROJECT -->
                            <li class="dropdown-header text-muted small">
                                Blue Print Project
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Home"
                                   asp-action="Create_project">
                                    <i class="bi bi-folder-plus me-2"></i> Create Project
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Home"
                                   asp-action="Upload">
                                    <i class="bi bi-upload me-2"></i> Upload
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Home"
                                   asp-action="Review">
                                    <i class="bi bi-eye me-2"></i> Review
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Home"
                                   asp-action="Blueprint">
                                    <i class="bi bi-diagram-3 me-2"></i> Blueprint
                                </a>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <!-- TOOLS -->
                            <li class="dropdown-header text-muted small">
                                Tools
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Home"
                                   asp-action="ConvertProject">
                                    <i class="bi bi-arrow-repeat me-2"></i> Convert Project
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Home"
                                   asp-action="AISelection">
                                    <i class="bi bi-cpu me-2"></i> AI Selection
                                </a>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <!-- LOGOUT -->
                            <li>
                                <form asp-controller="Home"
                                      asp-action="MySpace_Login"
                                      method="post"
                                      class="px-3">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger w-100">
                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Logout
                                    </button>
                                </form>
                            </li>

                        </ul>
                    </li>

                </ul>

            </div>
        </nav>
    </header>

    <!-- PAGE CONTENT -->
    <div class="container content-wrapper">
        <div class="glass-body">
            @RenderBody()
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer-modern text-center mt-4 mb-3">
        <strong>© @DateTime.Now.Year — MySpace</strong>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
