<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MySpace</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link href="~/css/site.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-sm nav-modern">
            <div class="container-fluid">

                <a class="navbar-brand nav-brand-modern"
                   asp-controller="Home"
                   asp-action="Dashboard">
                    MySpace
                </a>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center"
                           href="#"
                           data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-2"></i> User Menu
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end glass-dropdown">
                            <li>
                                <a class="dropdown-item" asp-controller="Home" asp-action="MyAccount">
                                    <i class="bi bi-person me-2"></i> My Account
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Home" asp-action="MySpace_Dashboard">
                                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Home"
                                      asp-action="MySpace_Login"
                                      method="post"
                                      class="px-3">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger w-100">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>

            </div>
        </nav>
    </header>

    <!-- PAGE HEADER (TITLE + ZOOZOO) -->
    @{
        var pageTitle = ViewData["PageTitle"] as string;
        var pageSubtitle = ViewData["PageSubtitle"] as string;
        var showZooZoo = ViewData["ShowZooZoo"] as bool? ?? false;
    }

    @if (!string.IsNullOrEmpty(pageTitle))
    {
        <div class="content-wrapper">
            <div class="dashboard-container">
                <div class="dashboard-header mb-4">

                    <div class="dashboard-header-content">
                        <h1 class="dashboard-title">@pageTitle</h1>
                        <p class="dashboard-subtitle">@pageSubtitle</p>
                    </div>

                    @if (showZooZoo)
                    {
                        <!-- ZOOZOO ROBOT -->
                        <div class="dashboard-helper ai-helper" onclick="toggleZooZooChat()">
                            <div class="ai-robot">

                                <div class="ai-dialog">
                                    Need help? Ask me
                                </div>

                                <svg class="robot-svg" viewBox="0 0 140 120"
                                     xmlns="http://www.w3.org/2000/svg">

                                    <ellipse cx="70" cy="112" rx="26" ry="6"
                                             fill="rgba(0,0,0,0.08)" />

                                    <line x1="70" y1="14" x2="70" y2="28"
                                          stroke="#c7d2fe" stroke-width="2" />

                                    <circle cx="70" cy="10" r="5"
                                            class="robot-antenna-dot" />

                                    <rect x="40" y="26" width="60" height="42"
                                          rx="18" fill="#fff"
                                          stroke="#d1d5db" stroke-width="2" />

                                    <g class="robot-eyes">
                                        <circle cx="58" cy="48" r="6" fill="#111827" />
                                        <circle cx="82" cy="48" r="6" fill="#111827" />
                                    </g>

                                    <rect x="60" y="60" width="20" height="4"
                                          rx="2" fill="#9ca3af" />

                                    <rect x="38" y="70" width="64" height="36"
                                          rx="18" fill="#fff"
                                          stroke="#d1d5db" stroke-width="2" />

                                    <circle cx="70" cy="88" r="5"
                                            class="robot-chest-dot" />
                                </svg>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    }

    <!-- CHAT POPUP (GLOBAL) -->
    <div id="zoozooChat" class="zoozoo-chat">
        <div class="zoozoo-chat-header">
            <span>🤖 ZooZoo Assistant</span>
            <button onclick="toggleZooZooChat()">✖</button>
        </div>

        <div class="zoozoo-chat-body" id="chatBody">
            <div class="bot-msg">
                Hi! 👋 How can I help you today?
            </div>
        </div>

        <div class="zoozoo-chat-footer">
            <input type="text"
                   id="chatInput"
                   placeholder="Ask something..."
                   onkeypress="if(event.key==='Enter') sendZooZooMsg()" />
            <button onclick="sendZooZooMsg()">Send</button>
        </div>
    </div>

    <!-- PAGE CONTENT -->
    <div class="container content-wrapper">
        <div class="glass-body">
            @RenderBody()
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer-modern text-center mt-4 mb-3">
        <strong>© @DateTime.Now.Year — MySpace</strong>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js?v=@DateTime.Now.Ticks"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
